NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact page: deliver to SiteGround mailbox inquiries@hexasteel.sa.
# Preferred from DigitalOcean: Resend HTTPS email API (SMTP ports 25/465/587 blocked by default).
# Must verify CONTACT_RESEND_FROM_EMAIL domain with Resend, using applicable DNS records in Cloudflare.
# Store actual private values outside the release, in $HOME/hexasteel-v3/.env.contact (chmod 600).
CONTACT_RESEND_API_KEY=
CONTACT_RESEND_FROM_EMAIL=
# Optional alternative ONLY if DigitalOcean SMTP egress is confirmed unblocked.
CONTACT_SMTP_EGRESS_VERIFIED=false
SITEGROUND_SMTP_HOST=
SITEGROUND_SMTP_PORT=465
SITEGROUND_SMTP_USER=
SITEGROUND_SMTP_PASSWORD=

# Cloudflare Turnstile for hexasteel.sa (both required).
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Existing RFQ/feedback variables; contact recipient is fixed and independent.
CONTACT_TO_EMAIL=
RFQ_TO_EMAIL=
RFQ_SUBMISSIONS_ENABLED=false

# Sanity CMS uses published and approvedForWeb records.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Marketplace bank-transfer checkout. Store actual values in the protected
# runtime .env.contact file on DigitalOcean. Enable only after Finance validates
# the bank details, approved fulfillment terms, inbox and ClamAV socket.
MARKETPLACE_BANK_CHECKOUT_ENABLED=false
MARKETPLACE_BANK_NAME=
MARKETPLACE_BANK_BENEFICIARY=
MARKETPLACE_BANK_IBAN=
MARKETPLACE_FULFILLMENT_TERMS=
MARKETPLACE_FINANCE_EMAIL=
MARKETPLACE_CLAMAV_SOCKET=
