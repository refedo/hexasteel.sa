NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact page: SiteGround authenticated SMTP (separate from RFQ/feedback Resend).
# Use the OUTGOING server hostname from SiteGround > Email > Mail Configuration > Manual Settings.
# Never commit actual passwords. Store runtime values in $HOME/hexasteel-v3/.env.contact (mode 0600).
SITEGROUND_SMTP_HOST=
SITEGROUND_SMTP_PORT=465
SITEGROUND_SMTP_USER=
SITEGROUND_SMTP_PASSWORD=
# Cloudflare Turnstile: configured for hexasteel.sa on site and on server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Existing optional RFQ/customer feedback transactional provider; not used by /contact.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RFQ_TO_EMAIL=
# RFQ remains disabled until its independent storage, scanning and notification work is accepted.
RFQ_SUBMISSIONS_ENABLED=false

# Sanity CMS dataset should be configured separately in Sanity Studio.
# Website accepts only published and approvedForWeb CMS records.

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
