NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RFQ_TO_EMAIL=
# Configure CONTACT_FROM_EMAIL as a verified sender domain in Resend.
# RFQ_TO_EMAIL is the private sales recipient; falls back to CONTACT_TO_EMAIL.
# RFQ attachments are emailed directly, not persisted to public Sanity.

# Sanity CMS dataset should be configured separately in Sanity Studio
# Website accepts only published and approvedForWeb CMS records

# Optional commercial RFQ receiving mailbox (defaults to CONTACT_TO_EMAIL)
RFQ_TO_EMAIL=

# Enable RFQ uploads/email only after a successful live test; default OFF
RFQ_SUBMISSIONS_ENABLED=false

# Public search-engine ownership verification tags (no values until issued by owners).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Analytics/GA4 must not be activated without approved consent and measurement policy.
