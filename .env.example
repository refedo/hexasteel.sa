NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RFQ_TO_EMAIL=
# Durable private PostgreSQL intake + encrypted S3-compatible storage. All settings server-side.
RFQ_DATABASE_URL=
RFQ_DATABASE_CA_PEM=
RFQ_FILES_BUCKET=
RFQ_S3_ENDPOINT=
RFQ_S3_REGION=
RFQ_S3_ACCESS_KEY_ID=
RFQ_S3_SECRET_ACCESS_KEY=
# A private malware scanner must be configured before attachment upload is shown.
# POST binary file to a private HTTPS endpoint using Bearer token; respond 200 {"clean":true} or {"clean":false}.
RFQ_FILE_SCAN_URL=
RFQ_FILE_SCAN_TOKEN=
# Optional signed private lead handoff; downstream systems verify X-HEXA-Signature (HMAC SHA256).
RFQ_LEAD_WEBHOOK_URL=
RFQ_LEAD_WEBHOOK_SECRET=
# Configure CONTACT_FROM_EMAIL as a verified sender domain in Resend.
# RFQ_TO_EMAIL is the private sales recipient; falls back to CONTACT_TO_EMAIL.
# RFQ documents are stored privately and referenced only in the restricted Sales queue.

# Sanity CMS dataset should be configured separately in Sanity Studio
# Website accepts only published and approvedForWeb CMS records

# Enable durable RFQ intake only after DB migrations, outbox worker, scanner and end-to-end verification; default OFF
RFQ_SUBMISSIONS_ENABLED=false
